# Regenerated lab state and credentials (scripts/setup.sh creates a fresh lab CA, TLS
# keys, swtpm state and registry under run/; never publish them)
**/run/
*.pem
*.key
*.pid
*.sock
# Local toolchains, build output, caches
**/.toolchain/
**/target/
**/bin/
# Rust executable source is code, not build output.
!**/src/bin/
!**/src/bin/*.rs
**/zk/proof-cache/*
!**/zk/proof-cache/README.md
**/__pycache__/
# PQ device bridge build output (GPLv3 tool; built by scripts/build_pq_toolchain.sh)
pq-identity/tools/pqtpm/pqtpm
*.o
*.a
*.test
*.out
# New experiment runs are ignored; the published runs are listed explicitly.
**/results/*/2*/
!identity/results/binding/20261108-004047/
!identity/results/broad/20261107-194025/
!zk-component/results/zk/20261108-111817/
!pq-identity/results/pq/20261108-153049/
!pq-identity/results/device/20261108T130125Z/
!pq-identity/results/pq-bench/20261108-132255/
!pq-identity/results/zk-pq-smoke/20261108-154419/
**/results/snapshots/
# Paper build artifacts
paper/*.aux
paper/*.log
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/main.pdf
paper/ziptest/
paper/build/
# Editor / OS
.DS_Store
*.swp
