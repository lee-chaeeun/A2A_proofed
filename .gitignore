# Regenerated lab state and credentials (scripts/setup.sh creates a fresh lab CA, TLS
# keys, swtpm state and registry under run/; never publish them)
**/run/
*.pem
*.key
*.pid
*.sock
# Local toolchains, build output, caches
**/.toolchain/
**/target/
**/bin/
**/zk/proof-cache/*
!**/zk/proof-cache/README.md
**/__pycache__/
*.test
*.out
# New experiment runs: retained evidence is committed deliberately by path; anything new
# under results/ must be added with `git add -f` after review
**/results/zk/2*/
**/results/zk-integration/2*/
**/results/v3-final/2*/
**/results/v2/2*/
**/results/v3/2*/
**/results/v3-repro/2*/
**/results/audit/2*/
